{
  "name": "verifica-onchain-proof",
  "version": "0.1.0",
  "private": true,
  "description": "베리피카브릿지 정산 검증 리포트 해시 온체인 기록",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
