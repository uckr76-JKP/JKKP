    "ledger": "ts-node --transpile-only cli/ledger.ts"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "dotenv": "^16.4.5",
    "hardhat": "^2.22.19",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
