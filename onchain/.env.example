# Polygon Amoy 테스트넷 RPC (비워두면 공개 RPC 사용)
AMOY_RPC_URL=
# 배포·기록용 지갑 개인키. 테스트넷 전용 지갑을 쓰고, 절대 커밋하지 마세요.
DEPLOYER_PRIVATE_KEY=
# 배포 후 출력되는 컨트랙트 주소
REGISTRY_ADDRESS=
# 경량 원장 저장소. DATABASE_URL이 있으면 Postgres(Supabase), 없으면 LEDGER_FILE(JSON)
# Supabase: Project Settings → Database → Connection string (Session pooler). DB 비밀번호 포함 — 서버에만 두세요.
DATABASE_URL=
LEDGER_FILE=
